POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-another-long-random-password
VKS_PORT=8765
VKS_MCP_RESOURCE=http://127.0.0.1:8788/mcp
# Optional model gateway: the UI accepts a reference, never a plaintext secret.
VKS_MODEL_ALLOWED_ORIGINS=
VKS_MODEL_ALLOWED_CIDRS=0.0.0.0/0,::/0
VKS_MODEL_API_KEY=

# Enable only together with the isolated runner profile and registered test origins.
VKS_RUNNER_ENABLED=0
VKS_RUNNER_ALLOW_LOOPBACK=0

# Optional private instance registry path; mount read-only via a local override.
VKS_RUNNER_SECRET_REGISTRY=

# Set to 1 after enabling the runner profile and approved test network.
