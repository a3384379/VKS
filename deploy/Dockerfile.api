FROM python:3.12-slim-bookworm
WORKDIR /app
COPY deploy/requirements.lock.txt /app/requirements.lock.txt
RUN pip install --no-cache-dir -r requirements.lock.txt
COPY services services
COPY packages packages
COPY fixtures fixtures
COPY deploy deploy
COPY scripts scripts
COPY alembic.ini alembic.ini
ENV PYTHONPATH=/app/services/api:/app VKS_DATA_DIR=/data/vks VKS_DATABASE_URL=sqlite:////data/vks/vks.db PYTHONDONTWRITEBYTECODE=1
RUN useradd --uid 10001 --create-home vks && mkdir -p /data/vks && chown -R vks:vks /data
USER vks
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn vks_api.app:app --host 0.0.0.0 --port 8000 --workers 1"]
