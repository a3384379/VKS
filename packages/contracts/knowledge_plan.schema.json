{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "steps",
    "unknowns"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "unknowns": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "target_revision_ids",
          "evidence_ids",
          "relation_type",
          "rationale",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,23}$"
          },
          "tool": {
            "type": "string",
            "enum": [
              "inspect_action",
              "inspect_evidence",
              "propose_relation",
              "propose_journey",
              "draft_document"
            ]
          },
          "target_revision_ids": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 36
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 36
            }
          },
          "relation_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "may_call",
                  "depends_on",
                  "documents",
                  "implements"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          }
        }
      }
    }
  }
}
