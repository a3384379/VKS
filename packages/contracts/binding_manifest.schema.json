{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vks:contracts:binding-manifest:1.0",
  "title": "VKS 1.0 Explicit Knowledge Bindings",
  "description": "外部 AI 或人工随 HTML/Markdown 导入的显式绑定清单。不依赖平台 LLM。服务端按 projectKey + baselineKey 解析 logicalKey，验证制品/hash/locator，并生成候选关系；有效性与因果依据由准确来源和证据决定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectKey",
    "baselineKey",
    "evidence",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectKey": {
      "$ref": "#/$defs/logicalKey"
    },
    "baselineKey": {
      "$ref": "#/$defs/logicalKey"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "external_ai",
            "platform_analyzer",
            "manual"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "logicalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
      "description": "安全归一化、越界、符号链接与重复路径由服务端检查。"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromLogicalKey",
        "toLogicalKey",
        "relationType",
        "evidenceRefs"
      ],
      "properties": {
        "fromLogicalKey": {
          "$ref": "#/$defs/logicalKey"
        },
        "toLogicalKey": {
          "$ref": "#/$defs/logicalKey"
        },
        "relationType": {
          "enum": [
            "contains",
            "renders",
            "handler_of",
            "may_call",
            "observed_during",
            "implements",
            "maps_to_sql",
            "reads_table",
            "writes_table",
            "documents",
            "depends_on"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/logicalKey"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "description": "不接受 confirmed/review_status/validity_status/causal_basis 字段。confirmed_trigger 由服务端验证运行相关证据后建立，不允许通过包声明直接升级。"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceKey",
        "evidenceKind",
        "artifactPath",
        "sha256",
        "locator"
      ],
      "properties": {
        "evidenceKey": {
          "$ref": "#/$defs/logicalKey"
        },
        "evidenceKind": {
          "enum": [
            "manual",
            "semantic",
            "static",
            "observed"
          ]
        },
        "artifactPath": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "claim": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "description": "evidenceKind 是来源声明。服务端重新验证，无法证实的声明保持 semantic/manual，不能升级成静态或运行事实。"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startLine",
            "endLine"
          ],
          "properties": {
            "kind": {
              "const": "file_lines"
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "qualifiedName": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pageKey",
            "actionKey"
          ],
          "properties": {
            "kind": {
              "const": "dom_attribute"
            },
            "pageKey": {
              "$ref": "#/$defs/logicalKey"
            },
            "actionKey": {
              "$ref": "#/$defs/logicalKey"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sectionKey",
            "startLine",
            "endLine"
          ],
          "properties": {
            "kind": {
              "const": "document_section"
            },
            "sectionKey": {
              "$ref": "#/$defs/logicalKey"
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stepKey",
            "requestId"
          ],
          "properties": {
            "kind": {
              "const": "network_request"
            },
            "stepKey": {
              "$ref": "#/$defs/logicalKey"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "traceId": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      ]
    }
  }
}
