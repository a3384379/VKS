{
  "schema_version": "3.0-dev",
  "tools": [
    {
      "name": "get_interactive_context",
      "title": "读取交互目标的关联与文档",
      "description": "读取准确草稿或保存版本的控件关联、可见文档和章节候选；返回保存所需的版本。",
      "inputSchema": {
        "$defs": {
          "ControlContext": {
            "additionalProperties": false,
            "properties": {
              "scope": {
                "default": "control",
                "enum": [
                  "control",
                  "module"
                ],
                "title": "Scope",
                "type": "string"
              },
              "page_title": {
                "default": "",
                "maxLength": 200,
                "title": "Page Title",
                "type": "string"
              },
              "section_title": {
                "default": "",
                "maxLength": 200,
                "title": "Section Title",
                "type": "string"
              },
              "nearby_labels": {
                "items": {
                  "maxLength": 80,
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Nearby Labels",
                "type": "array"
              }
            },
            "title": "ControlContext",
            "type": "object"
          },
          "DOMTarget": {
            "additionalProperties": false,
            "properties": {
              "route": {
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "^/",
                "title": "Route",
                "type": "string"
              },
              "frame_path": {
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Frame Path",
                "type": "array"
              },
              "selector": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Selector",
                "type": "string"
              },
              "label": {
                "maxLength": 160,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "state": {
                "default": "",
                "maxLength": 500,
                "title": "State",
                "type": "string"
              },
              "open_steps": {
                "items": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Open Steps",
                "type": "array"
              }
            },
            "required": [
              "route",
              "frame_path",
              "selector",
              "label"
            ],
            "title": "DOMTarget",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "analysis_set_id": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Set Id"
          },
          "release_id": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Release Id"
          },
          "package_id": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Package Id",
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/DOMTarget"
          },
          "context": {
            "$ref": "#/$defs/ControlContext"
          },
          "mode": {
            "default": "explain",
            "enum": [
              "documents",
              "explain"
            ],
            "title": "Mode",
            "type": "string"
          },
          "refresh": {
            "default": false,
            "title": "Refresh",
            "type": "boolean"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "package_id",
          "target",
          "project_id"
        ],
        "title": "AssistanceInput",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "meta": {
            "additionalProperties": true,
            "title": "Meta",
            "type": "object"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "PrototypeEnvelope[dict]",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "save_interactive_binding",
      "title": "保存交互目标的关联文案",
      "description": "共用 Studio 保存服务；修改时必须提交读取所得 binding_id、binding_version、point_revision_id 和 selection_version。保留不可变历史，相同幂等键可重试。",
      "inputSchema": {
        "$defs": {
          "DOMTarget": {
            "additionalProperties": false,
            "properties": {
              "route": {
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "^/",
                "title": "Route",
                "type": "string"
              },
              "frame_path": {
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Frame Path",
                "type": "array"
              },
              "selector": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Selector",
                "type": "string"
              },
              "label": {
                "maxLength": 160,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "state": {
                "default": "",
                "maxLength": 500,
                "title": "State",
                "type": "string"
              },
              "open_steps": {
                "items": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Open Steps",
                "type": "array"
              }
            },
            "required": [
              "route",
              "frame_path",
              "selector",
              "label"
            ],
            "title": "DOMTarget",
            "type": "object"
          },
          "PointText": {
            "additionalProperties": false,
            "properties": {
              "title": {
                "maxLength": 160,
                "minLength": 1,
                "pattern": "\\S",
                "title": "Title",
                "type": "string"
              },
              "summary": {
                "maxLength": 512000,
                "minLength": 1,
                "pattern": "\\S",
                "title": "Summary",
                "type": "string"
              },
              "applicability": {
                "default": "",
                "maxLength": 2000,
                "title": "Applicability",
                "type": "string"
              },
              "outcome": {
                "default": "",
                "maxLength": 2000,
                "title": "Outcome",
                "type": "string"
              },
              "exceptions": {
                "default": "",
                "maxLength": 2000,
                "title": "Exceptions",
                "type": "string"
              }
            },
            "required": [
              "title",
              "summary"
            ],
            "title": "PointText",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "analysis_set_id": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Analysis Set Id",
            "type": "string"
          },
          "package_id": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Package Id",
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/DOMTarget"
          },
          "point": {
            "$ref": "#/$defs/PointText"
          },
          "section_revision_ids": {
            "items": {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Section Revision Ids",
            "type": "array"
          },
          "binding_id": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Binding Id"
          },
          "binding_version": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Binding Version"
          },
          "point_revision_id": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Point Revision Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "selection_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "analysis_set_id",
          "package_id",
          "target",
          "point",
          "section_revision_ids",
          "project_id",
          "idempotency_key",
          "selection_version"
        ],
        "title": "InteractiveBinding",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "meta": {
            "additionalProperties": true,
            "title": "Meta",
            "type": "object"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "PrototypeEnvelope[dict]",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "openWorldHint": false,
        "idempotentHint": true
      }
    },
    {
