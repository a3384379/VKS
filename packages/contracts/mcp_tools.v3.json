    {
      "name": "get_prototype_action_context",
      "title": "读取原型动作与业务说明",
      "description": "读取准确版本、页面及触发状态中的可见业务点和原文章节。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "action_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,95}$"
          },
          "page_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,95}$"
          },
          "trigger_state_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,95}$"
