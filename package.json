{
  "name": "vks-workspace",
  "private": true,
  "version": "3.0.0-rc.1",
  "workspaces": [
    "apps/web",
    "apps/studio"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm run build --workspace apps/web && npm run build --workspace apps/studio",
    "check": "npm run test && npm run build && uv run pytest",
    "test": "npm run test --workspace apps/web",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" apps/web/vite.config.ts",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" apps/web/vite.config.ts",
    "dev:studio": "bash scripts/dev-studio.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
